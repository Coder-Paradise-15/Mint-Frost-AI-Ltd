# ==============================================================================
# Mint Frost AI - Environment Template Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file with secrets to Git.
# ==============================================================================

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Server & Flask Security ---
SECRET_KEY=your_random_secret_key_here
PORT=5001
FLASK_DEBUG=False

# --- Initial Superadmin Credentials ---
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=your_admin_password_here

# --- Weather Service ---
WEATHER_API_KEY=your_openweather_api_key

# --- Email / SMTP Notifications ---
MAIL_ID=your_email@example.com
MAIL_PASSWORD=your_email_password
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_email_password

# --- AI Provider API Keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Database & Engine ---
DATABASE_PATH=chat.db
FROST_ENDPOINT=
