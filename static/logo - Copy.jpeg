<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 60" width="200" height="60">
  <defs>
    <linearGradient id="mintGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#37e6b5;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1ccaa0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#12b18b;stop-opacity:1" />
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge> 
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Logo Icon -->
  <g transform="translate(10, 10)">
    <!-- Background circle -->
    <circle cx="20" cy="20" r="18" fill="url(#mintGradient)" opacity="0.15"/>
    
    <!-- AI Neural Network -->
    <g fill="url(#mintGradient)" filter="url(#glow)">
      <!-- Central processing unit -->
      <circle cx="20" cy="20" r="4"/>
      
      <!-- Neural nodes -->
      <circle cx="8" cy="12" r="2"/>
      <circle cx="32" cy="12" r="2"/>
      <circle cx="8" cy="28" r="2"/>
      <circle cx="32" cy="28" r="2"/>
      <circle cx="20" cy="6" r="1.5"/>
      <circle cx="20" cy="34" r="1.5"/>
      
      <!-- Neural connections -->
      <line x1="20" y1="20" x2="8" y2="12" stroke="url(#mintGradient)" stroke-width="2" opacity="0.8"/>
      <line x1="20" y1="20" x2="32" y2="12" stroke="url(#mintGradient)" stroke-width="2" opacity="0.8"/>
      <line x1="20" y1="20" x2="8" y2="28" stroke="url(#mintGradient)" stroke-width="2" opacity="0.8"/>
      <line x1="20" y1="20" x2="32" y2="28" stroke="url(#mintGradient)" stroke-width="2" opacity="0.8"/>
      <line x1="20" y1="20" x2="20" y2="6" stroke="url(#mintGradient)" stroke-width="1.5" opacity="0.6"/>
      <line x1="20" y1="20" x2="20" y2="34" stroke="url(#mintGradient)" stroke-width="1.5" opacity="0.6"/>
      
      <!-- Frost crystals -->
      <path d="M14 8 L16 10 L14 12 L12 10 Z" opacity="0.7"/>
      <path d="M26 8 L28 10 L26 12 L24 10 Z" opacity="0.7"/>
      <path d="M14 28 L16 30 L14 32 L12 30 Z" opacity="0.7"/>
      <path d="M26 28 L28 30 L26 32 L24 30 Z" opacity="0.7"/>
    </g>
  </g>
  
  <!-- Text Logo -->
  <g transform="translate(60, 15)">
    <text x="0" y="20" font-family="Inter, sans-serif" font-size="18" font-weight="700" fill="url(#mintGradient)">
      Mint Frost
    </text>
    <text x="0" y="38" font-family="Inter, sans-serif" font-size="12" font-weight="500" fill="#a6b7b2" opacity="0.9">
      AI ASSISTANT
    </text>
  </g>
</svg>